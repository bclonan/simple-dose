{
  "name": "cleardose-webmcp-demo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "vue-tsc -b",
    "test": "vitest run",
    "test:evals": "vitest run --config tests/evals/vitest.config.ts",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "build": "pnpm typecheck && vite build",
    "verify": "pnpm typecheck && pnpm test && pnpm test:evals && pnpm build && pnpm test:e2e",
    "preview": "vite preview"
  },
  "dependencies": {
    "pinia": "4.0.3",
    "vue": "3.5.42",
    "vue-router": "5.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "26.4.0",
    "@vitejs/plugin-vue": "6.0.8",
    "@vue/test-utils": "2.5.0",
    "jsdom": "30.0.1",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "vue-tsc": "3.3.11"
  },
  "packageManager": "pnpm@11.8.0"
}
